# Copie para .env e preencha. O .env nunca vai para o Git.
NODE_ENV=production
PORT=3200

# Banco MySQL (o do docker-compose)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=ocpsuporte
DB_USER=ocpsuporte
DB_PASSWORD=

# Segredo das sessões: 64+ caracteres aleatórios (openssl rand -hex 48)
SESSION_SECRET=

# Portal do cliente (links dos e-mails dos clientes) e painel da OCP (links dos e-mails da equipe)
BASE_URL=https://suporte.ocp.com.br
PAINEL_URL=https://zgx-ocp.tail8d7ec5.ts.net:3200

# Anexos (fora da pasta pública)
PASTA_ANEXOS=data/anexos

# E-mail de saída (Hostinger: smtp.hostinger.com, porta 465, SSL)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=notifications@ocp.com.br
SMTP_PASSWORD=
SMTP_FROM="OCP Suporte <notifications@ocp.com.br>"
# "smtp" envia de verdade; "arquivo" só grava em data/emails (testes)
EMAIL_MODO=smtp

# Chamado resolvido sem retorno do cliente fecha sozinho depois de N dias
DIAS_FECHAR_RESOLVIDO=5

# Nome público (Cloudflare Tunnel, Fase 4). Por ele só passam login, conta, portal e estáticos (src/publico.ts)
HOST_PUBLICO=suporte.ocp.com.br
