{
  "name": "ocpsuporte",
  "version": "0.1.0",
  "private": true,
  "description": "Portal de chamados de suporte da OCP",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrar": "tsx src/db/migrar.ts",
    "criar-admin": "tsx scripts/criar-admin.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "multer": "^2.0.2",
    "mysql2": "^3.12.0",
    "nodemailer": "~10.1.7",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/express-mysql-session": "^3.0.6",
    "@types/express-session": "^1.18.1",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "mysql2": "$mysql2"
  }
}
