<%- include("../partes/topo", { titulo: numero(ch.id) }) %>
<div class="cabecalho">
  <h1><%= numero(ch.id) %> · <%= ch.titulo %></h1>
  <div class="botoes">
    <span class="pr pr-<%= ch.prioridade %>"><%= PRIORIDADES[ch.prioridade] %></span>
    <%- include("../partes/situacao", { status: ch.status }) %>
  </div>
</div>
<div class="chamado">
  <section>
    <%- include("../partes/ficha-triagem", { ch, triagem, parecidos }) %>
    <%- include("../partes/mensagens", { mensagens, rotaAnexos: "/painel/anexos" }) %>

    <form method="post" action="/painel/chamados/<%= ch.id %>/responder" enctype="multipart/form-data" class="cartao" id="responder">
      <h2>Responder</h2>
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="opcoes-radio">
        <label><input type="radio" name="visibilidade" value="publica" checked <%= ["fechado", "cancelado"].includes(ch.status) ? "disabled" : "" %>> Resposta ao cliente</label>
        <label><input type="radio" name="visibilidade" value="interna" <%= ["fechado", "cancelado"].includes(ch.status) ? "checked" : "" %>> Nota interna</label>
      </div>
      <label><textarea name="texto" rows="6" maxlength="20000" required data-colar-anexos placeholder="Mensagem"></textarea></label>
      <% if (!["fechado", "cancelado"].includes(ch.status)) { %>
      <label>E mudar a situação para
        <select name="status">
          <option value="">(automático: em atendimento)</option>
          <option value="em_atendimento">Em atendimento</option>
          <option value="aguardando_cliente">Aguardando cliente (pedir informação)</option>
          <option value="resolvido">Resolvido (a mensagem é a solução)</option>
        </select>
      </label>
      <% } %>
      <%- include("../partes/campo-anexos") %>
      <button class="primario">Enviar</button>
    </form>

    <details class="cartao">
      <summary><strong>Histórico</strong></summary>
      <table class="historico">
        <% for (const e of eventos) { %>
          <tr><td><%= dataHora(e.criado_em) %></td><td><%= e.usuario ?? "Sistema" %></td><td><%= e.acao.replaceAll("_", " ") %></td><td><%= e.ip ?? "" %></td></tr>
        <% } %>
      </table>
    </details>
  </section>

  <aside class="chamado-lado">
    <div class="cartao">
      <dl class="ficha">
        <dt>Cliente</dt><dd><%= ch.cliente %></dd>
        <dt>Solicitante</dt><dd><%= ch.solicitante_nome %><br><span class="sutil"><%= ch.solicitante_email %></span></dd>
        <% if (ch.departamento) { %><dt>Depto.</dt><dd><%= ch.departamento %></dd><% } %>
        <% if (ch.sistema) { %><dt>Sistema</dt><dd><%= ch.sistema %><% if (ch.sistema_acesso) { %><br><span class="sutil"><%= ch.sistema_acesso %></span><% } %></dd><% } %>
        <dt>Tipo</dt><dd><%= TIPOS[ch.tipo] %></dd>
        <dt>Impacto</dt><dd><%= IMPACTOS[ch.impacto] %></dd>
        <dt>Canal</dt><dd><%= ch.canal %></dd>
        <dt>Aberto</dt><dd><%= dataHora(ch.criado_em) %></dd>
        <% if (ch.primeira_resposta_em) { %><dt>1ª resposta</dt><dd><%= dataHora(ch.primeira_resposta_em) %></dd><% } %>
        <% if (ch.resolvido_em) { %><dt>Resolvido</dt><dd><%= dataHora(ch.resolvido_em) %></dd><% } %>
        <dt>Área</dt><dd><%= ch.area ?? "—" %></dd>
        <dt>Responsável</dt><dd><%= ch.responsavel_nome ?? "—" %></dd>
      </dl>
      <% if (!ch.responsavel_id && !["fechado", "cancelado"].includes(ch.status)) { %>
      <form method="post" action="/painel/chamados/<%= ch.id %>/assumir">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <p><button class="secundario">Assumir este chamado</button></p>
      </form>
      <% } %>
    </div>

    <div class="cartao" id="prazos">
      <h2>Prazos <span class="sutil">(horário útil)</span></h2>
      <dl class="ficha">
        <dt>1ª resposta</dt><dd><%- include("../partes/prazo", { p: prazos.resposta }) %><% if (ch.prazo_resposta_em) { %><br><span class="sutil">até <%= dataHora(ch.prazo_resposta_em) %></span><% } %></dd>
        <dt>Solução</dt><dd><%- include("../partes/prazo", { p: prazos.solucao }) %><% if (ch.prazo_solucao_em && prazos.solucao.estado !== "pausado") { %><br><span class="sutil">até <%= dataHora(ch.prazo_solucao_em) %></span><% } %></dd>
      </dl>
      <% if (ch.status === "triagem") { %><p class="dica">Os prazos começam quando a triagem termina.</p><% } %>
    </div>

    <div class="cartao" id="horas">
      <h2>Horas <span class="sutil">(o cliente não vê)</span></h2>
      <% if (horas.lista.length) { %>
      <table class="horas">
        <% for (const a of horas.lista) { %>
        <tr>
          <td><%= a.dia.split("-").reverse().join("/") %><br><span class="sutil"><%= a.usuario.split(" ")[0] %></span></td>
          <td class="quebra"><%= a.descricao %><% if (!a.faturavel) { %> <span class="etiqueta">não conta no pacote</span><% } %></td>
          <td><strong><%= hhmm(a.minutos) %></strong>
            <% if (usuario.papel === "admin" || a.usuario_id === usuario.id) { %>
            <form method="post" action="/painel/chamados/<%= ch.id %>/horas/<%= a.id %>/remover" class="inline" data-confirmar="Remover este lançamento?">
              <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link perigo" title="Remover">✕</button>
            </form>
            <% } %>
          </td>
        </tr>
        <% } %>
        <tr><td colspan="2"><strong>Total</strong></td><td><strong><%= hhmm(horas.total) %></strong></td></tr>
      </table>
      <% } else { %><p class="sutil">Nenhuma hora lançada.</p><% } %>
      <details class="editar" <%= horas.lista.length ? "" : "open" %>>
        <summary>+ Lançar horas</summary>
        <form method="post" action="/painel/chamados/<%= ch.id %>/horas">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <div class="linha linha-horas">
            <label>Data <input type="date" name="data" value="<%= hoje %>" max="<%= hoje %>" required></label>
            <label>Horas <input type="number" name="horas" min="0" max="24" step="1" value="0" inputmode="numeric"></label>
            <label>Minutos <input type="number" name="minutos" min="0" max="59" step="5" value="30" inputmode="numeric"></label>
          </div>
          <label>O que foi feito <input name="descricao" maxlength="500" required placeholder="Ex.: análise do log e reenvio da NF-e"></label>
          <% if (usuario.papel === "admin") { %>
          <label class="check"><input type="checkbox" name="faturavel" value="0"> Não conta no pacote do cliente (retrabalho, cortesia…)</label>
          <% } %>
          <button class="primario">Lançar</button>
        </form>
      </details>
    </div>

    <% if (usuario.papel === "admin") { %>
    <form method="post" action="/painel/chamados/<%= ch.id %>/distribuir" class="cartao">
      <h2>Distribuição</h2>
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label>Área
        <select name="area_id">
          <option value="">—</option>
          <% for (const a of areas) { %><option value="<%= a.id %>" <%= ch.area_id === a.id ? "selected" : "" %>><%= a.nome %></option><% } %>
        </select>
      </label>
      <label>Responsável
        <select name="responsavel_id">
          <option value="">— sem responsável —</option>
          <% for (const p of equipe) { %><option value="<%= p.id %>" <%= ch.responsavel_id === p.id ? "selected" : "" %>><%= p.nome %><%= p.id === usuario.id ? " (eu)" : "" %><%= p.areas ? " · " + p.areas : "" %></option><% } %>
        </select>
      </label>
      <div class="linha">
        <label>Prioridade
          <select name="prioridade"><% for (const [k, v] of Object.entries(PRIORIDADES)) { %><option value="<%= k %>" <%= ch.prioridade === k ? "selected" : "" %>><%= v %></option><% } %></select>
        </label>
        <label>Tipo
          <select name="tipo"><% for (const [k, v] of Object.entries(TIPOS)) { %><option value="<%= k %>" <%= ch.tipo === k ? "selected" : "" %>><%= v %></option><% } %></select>
        </label>
      </div>
      <button class="primario">Salvar</button>
    </form>
    <div class="cartao">
      <% if (["resolvido", "fechado", "cancelado"].includes(ch.status)) { %>
      <form method="post" action="/painel/chamados/<%= ch.id %>/reabrir">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="secundario">Reabrir chamado</button>
      </form>
      <% } %>
      <% if (!["fechado", "cancelado"].includes(ch.status)) { %>
      <details class="editar">
        <summary>Cancelar chamado</summary>
        <form method="post" action="/painel/chamados/<%= ch.id %>/cancelar" data-confirmar="Cancelar este chamado? O cliente será avisado.">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <label>Motivo (vai para o cliente) <input name="motivo" maxlength="500"></label>
          <button class="secundario perigo-borda">Cancelar</button>
        </form>
      </details>
      <% } %>
    </div>
    <% } %>

    <% if (outros.length) { %>
    <div class="cartao">
      <h2>Outros chamados do solicitante</h2>
      <% for (const o of outros) { %>
        <p><a href="/painel/chamados/<%= o.id %>"><%= numero(o.id) %></a> <%= o.titulo %><br><span class="sutil"><%= SITUACOES_EQUIPE[o.status] %> · <%= data(o.criado_em) %></span></p>
      <% } %>
    </div>
    <% } %>
  </aside>
</div>
<%- include("../partes/rodape") %>
