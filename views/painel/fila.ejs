<%- include("../partes/topo", { titulo: "Chamados" }) %>
<div class="cabecalho">
  <h1>Chamados</h1>
  <form method="get" class="botoes">
    <input type="hidden" name="fila" value="<%= fila %>">
    <select name="cliente" aria-label="Cliente" data-enviar-ao-mudar>
      <option value="">Todos os clientes</option>
      <% for (const c of clientes) { %><option value="<%= c.id %>" <%= clienteId === c.id ? "selected" : "" %>><%= c.nome %></option><% } %>
    </select>
    <noscript><button class="secundario">Filtrar</button></noscript>
  </form>
</div>
<nav class="abas">
  <% for (const [k, f] of Object.entries(filas)) { %>
    <a href="?fila=<%= k %><%= clienteId ? '&cliente=' + clienteId : '' %>" class="<%= k === fila ? 'ativa' : '' %>"><%= f.titulo %><% if (k in contagens) { %><span class="contagem"><%= contagens[k] %></span><% } %></a>
  <% } %>
</nav>
<div class="cartao">
<% if (!chamados.length) { %>
  <p class="sutil">Nenhum chamado aqui.</p>
<% } else { %>
  <table>
    <thead><tr><th>Nº</th><th>Assunto</th><th>Cliente</th><th>Prioridade</th><th>Situação</th><th>Prazo</th><th>Responsável</th><th>Aberto</th></tr></thead>
    <tbody>
    <% for (const c of chamados) { %>
      <tr>
        <td><a href="/painel/chamados/<%= c.id %>"><%= numero(c.id) %></a></td>
        <td class="quebra"><a href="/painel/chamados/<%= c.id %>"><%= c.titulo %></a><br><span class="sutil"><%= TIPOS[c.tipo] %> · <%= c.solicitante %></span>
          <% if (c.resumo) { %><span class="resumo-fila" title="<%= c.resumo %>">🤖 <%= c.resumo %></span><% } %></td>
        <td><%= c.cliente %></td>
        <td><span class="pr pr-<%= c.prioridade %>"><%= PRIORIDADES[c.prioridade] %></span>
          <% if (c.sugestao_prioridade && c.sugestao_prioridade !== c.prioridade) { %><br><span class="sutil">🤖 <%= PRIORIDADES[c.sugestao_prioridade] %></span><% } %></td>
        <td><%- include("../partes/situacao", { status: c.status }) %></td>
        <td><% const pz = c.primeira_resposta_em || c.prazos.resposta.estado === "sem" ? c.prazos.solucao : c.prazos.resposta; %>
          <%- include("../partes/prazo", { p: pz }) %><% if (pz.estado !== "sem" && pz.estado !== "pausado") { %><br><span class="sutil"><%= pz === c.prazos.resposta ? "1ª resposta" : "solução" %></span><% } %></td>
        <td><%= c.responsavel ?? "—" %><% if (c.area) { %><br><span class="sutil"><%= c.area %></span><% } %>
          <% if (!c.responsavel && c.sugestao_responsavel) { %><br><span class="sutil">🤖 sugestão: <%= c.sugestao_responsavel %></span><% } %></td>
        <td><%= dataHora(c.criado_em) %></td>
      </tr>
    <% } %>
    </tbody>
  </table>
<% } %>
</div>
<%- include("../partes/rodape") %>
